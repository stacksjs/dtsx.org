<script server>
import macReport from '~/public/benchmarks/results.json'
import linuxReport from '~/public/benchmarks/results-linux.json'
import macInferred from '~/public/benchmarks/results-inferred.json'
import linuxInferred from '~/public/benchmarks/results-linux-inferred.json'
import engineReport from '~/public/benchmarks/engine.json'
import { benchmarkName } from '~/resources/functions/benchmark-names'
const title = 'The declaration benchmark lab'
const description = 'Compare dtsx with TypeScript, Oxc, SWC, tsdown, tsup, Rollup, API Extractor, and unplugin tools using reproducible benchmarks.'
const pathname = '/benchmarks/'
const groups = [
  { id: 'project-emit', name: 'Per-module emission', detail: 'Declarations per source file. A semantic typecheck is not required.' },
  { id: 'checked-project', name: 'Checked compiler builds', detail: 'Includes semantic diagnostics. These compilers do extra work; compare within this group.' },
  { id: 'bundled-project', name: 'Standalone bundles', detail: 'One public declaration entry. Checking and JavaScript work vary by pipeline.' },
]
const sizes = [1, 25, 100]
const snapshots = [
  { id: 'macos-annotated', platform: 'macos', workload: 'annotated', workloadLabel: 'Explicit annotations', label: 'macOS', path: '/benchmarks/results.json', report: macReport },
  { id: 'linux-annotated', platform: 'linux', workload: 'annotated', workloadLabel: 'Explicit annotations', label: 'Linux', path: '/benchmarks/results-linux.json', report: linuxReport },
  { id: 'macos-inferred', platform: 'macos', workload: 'inferred', workloadLabel: 'Inferred APIs', label: 'macOS', path: '/benchmarks/results-inferred.json', report: macInferred },
  { id: 'linux-inferred', platform: 'linux', workload: 'inferred', workloadLabel: 'Inferred APIs', label: 'Linux', path: '/benchmarks/results-linux-inferred.json', report: linuxInferred },
].map(snapshot => ({ ...snapshot, report: { ...snapshot.report, results: snapshot.report.results.map(row => ({ ...row, name: benchmarkName(row) })) } })).map(snapshot => ({
  ...snapshot,
  measuredDate: new Date(snapshot.report.measuredAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' }),
  memoryGiB: Math.round(snapshot.report.machine.memoryBytes / (1024 ** 3)),
  measured: snapshot.report.results.filter(row => row.status === 'passed').length,
  fastestEmitter: snapshot.report.results.filter(row => row.modules === 100 && row.group === 'project-emit' && row.status === 'passed').sort((a, b) => a.medianMs - b.medianMs)[0]?.name ?? null,
  fastestBundler: snapshot.report.results.filter(row => row.modules === 100 && row.group === 'bundled-project' && row.status === 'passed').sort((a, b) => a.medianMs - b.medianMs)[0]?.name ?? null,
}))
// Engine benchmarks: dtsx's own suite (stacksjs/dtsx benchmark/index.ts), one file
// or one directory at a time, on a single local machine. Kept apart from the lab.
const formatNs = (ns) => ns < 1e3 ? `${ns.toFixed(0)} ns` : ns < 1e6 ? `${(ns / 1e3).toFixed(2)} µs` : `${(ns / 1e6).toFixed(2)} ms`
const engineMachine = engineReport.machine
const engineMeasured = new Date(`${engineReport.date}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'America/Los_Angeles' })
const engineCores = engineMachine.performanceCores && engineMachine.efficiencyCores ? `${engineMachine.cores}-core CPU (${engineMachine.performanceCores} performance + ${engineMachine.efficiencyCores} efficiency)` : `${engineMachine.cores}-core CPU`
const engineTable = (section, title, detail, tools, columns) => {
  const value = (tool, column) => engineReport.rows.find(row => row.section === section && row.tool === tool && row.input === column)?.avgNs
  const best = columns.map(column => Math.min(...tools.map(tool => value(tool.key, column) ?? Infinity)))
  const score = tool => columns.reduce((sum, column, index) => sum + (value(tool.key, column) ?? Infinity) / best[index], 0)
  const rows = [...tools].sort((a, b) => score(a) - score(b)).map(tool => ({
    name: tool.label,
    dtsx: tool.key.includes('dtsx'),
    cells: columns.map((column, index) => {
      const ns = value(tool.key, column)
      if (ns === undefined) return { text: '-', best: false, ratio: '' }
      const ratio = ns / best[index]
      return { text: formatNs(ns), best: ns === best[index], ratio: ns === best[index] ? '' : `${ratio >= 10 ? ratio.toFixed(0) : ratio >= 2 ? ratio.toFixed(1) : ratio.toFixed(2)}x` }
    }),
  }))
  return { id: `engine-${section}`, title, detail, columns, rows }
}
const engineInputs = engineReport.inputs.map(input => input.name)
const engineProjects = engineReport.projects.map(count => `${count} files`)
// Result keys: `zig-dtsx` is the native engine, shown as "dtsx"; `dtsx` is the
// TypeScript SDK, shown as "dtsx JS SDK" and compared only with JavaScript SDKs.
const engineTables = [
  engineTable('inproc', 'In-process API, no cache', 'One file per call: dtsx through its native binding, oxc-transform through N-API. Every dtsx cache is cleared on every iteration.', [{ key: 'zig-dtsx', label: 'dtsx' }, { key: 'oxc-transform', label: 'oxc-transform' }], engineInputs),
  engineTable('cli', 'CLI, single file', 'Each tool runs as an executable, so process startup is included. oxc has no declaration CLI, so it runs through a minimal Bun-compiled wrapper; tsc is TypeScript 7 native with --noCheck.', [{ key: 'zig-dtsx', label: 'dtsx' }, { key: 'oxc', label: 'oxc' }, { key: 'tsc', label: 'tsc 7' }], engineInputs),
  engineTable('project', 'CLI, multi-file project', 'A directory of generated modules. dtsx and tsc use multiple threads; oxc has no parallel declaration CLI.', [{ key: 'zig-dtsx', label: 'dtsx' }, { key: 'oxc', label: 'oxc' }, { key: 'tsc', label: 'tsc 7' }], engineProjects),
]
const sdkTables = [
  engineTable('inproc', 'JS SDK, in-process, no cache', 'The dtsx TypeScript SDK against oxc-transform, whose SDK runs Rust through N-API.', [{ key: 'dtsx', label: 'dtsx JS SDK' }, { key: 'oxc-transform', label: 'oxc-transform' }], engineInputs),
].map(table => ({ ...table, id: `${table.id}-sdk` }))
const engineBundled = engineReport.tsdown ? [...new Set(engineReport.tsdown.results.map(row => row.files))].map(files => {
  const rows = engineReport.tsdown.results.filter(row => row.files === files)
  const best = Math.min(...rows.map(row => row.avgMs))
  return { files, rows: rows.map(row => ({ tool: row.tool === 'dtsx' ? 'dtsx JS SDK' : 'tsdown JS SDK', text: `${row.avgMs.toFixed(2)} ms`, best: row.avgMs === best })) }
}) : []
</script>
<script client>
const theme = useColorMode({ attribute: 'data-theme' })
const size = state('100')
const platform = state('macos')
const workload = state('annotated')
</script>
@nolayout
<!DOCTYPE html>
<html lang="en">
<head>@include('head')</head>
<body>
@include('nav')
<main id="main" class="document-main shell">
  <a class="back-link" href="/">← Back to dtsx</a>
  <div class="document-heading"><h1>The numbers.<br><span>And how we got them.</span></h1><p>Choose a platform, fixture, and library size. Compare tools doing similar work.</p></div>
  <div class="lab-meta"><div><strong>16</strong><span>tool configurations</span></div><div><strong>3</strong><span>project sizes</span></div><div><strong>9</strong><span>samples per qualified case</span></div>@foreach(snapshots as snapshot)<div :if="platform() === '{{ snapshot.platform }}' && workload() === '{{ snapshot.workload }}'"><strong>{{ snapshot.measured }}/48</strong><span>qualified {{ snapshot.label }} cases</span></div>@endforeach</div>
  <div class="lab-controls">
    <div class="lab-control"><label for="benchmark-platform">Platform</label><span class="lab-select"><select id="benchmark-platform" x-model="platform"><option value="macos">macOS</option><option value="linux">Linux</option></select><span class="i-hugeicons-arrow-down-01" aria-hidden="true"></span></span></div>
    <div class="lab-control"><label for="benchmark-workload">Fixture</label><span class="lab-select"><select id="benchmark-workload" x-model="workload"><option value="annotated">Explicit annotations</option><option value="inferred">Inferred APIs</option></select><span class="i-hugeicons-arrow-down-01" aria-hidden="true"></span></span></div>
    <div class="lab-control"><label for="project-size">Library size</label><span class="lab-select"><select id="project-size" x-model="size"><option value="1">1 module + entry</option><option value="25">25 modules + entry</option><option value="100">100 modules + entry</option></select><span class="i-hugeicons-arrow-down-01" aria-hidden="true"></span></span></div>
    @foreach(snapshots as snapshot)<a :if="platform() === '{{ snapshot.platform }}' && workload() === '{{ snapshot.workload }}'" class="text-link" href="{{ snapshot.path }}" aria-label="Download {{ snapshot.label }} {{ snapshot.workloadLabel }} raw results" download>Download results ↓</a>@endforeach
  </div>
  @foreach(snapshots as snapshot)
  <div :if="platform() === '{{ snapshot.platform }}' && workload() === '{{ snapshot.workload }}'" data-benchmark-platform="{{ snapshot.platform }}" data-benchmark-workload="{{ snapshot.workload }}">
  @foreach(groups as group)
  <section class="lab-group" aria-labelledby="{{ snapshot.id }}-group-{{ group.id }}"><h2 id="{{ snapshot.id }}-group-{{ group.id }}">{{ group.name }}</h2><p>{{ group.detail }}</p>
    @foreach(sizes as count)
    <div :if="size() === '{{ count }}'" class="table-scroll"><table class="results-table"><caption>{{ snapshot.label }} · {{ snapshot.workloadLabel }} · {{ count }} {{ count === 1 ? 'module' : 'modules' }} + one entrypoint · milliseconds · lower is faster</caption><thead><tr><th scope="col">Tool / version</th><th scope="col">Median</th><th scope="col">Min - max</th><th scope="col">Samples</th></tr></thead><tbody>
    @foreach(snapshot.report.results.filter(row => row.group === group.id && row.modules === count).sort((a, b) => (a.medianMs ?? Infinity) - (b.medianMs ?? Infinity)) as row)
    <tr class="{{ row.id.startsWith('dtsx') ? 'highlight-row' : '' }}"><th scope="row">{{ row.name }}<small>{{ row.version }}</small></th>@if(row.status === 'passed')<td class="number">{{ row.medianMs.toFixed(1) }}</td><td class="number range">{{ row.minMs.toFixed(1) }} - {{ row.maxMs.toFixed(1) }}</td><td>{{ row.samplesMs.length }} / 9</td>@else<td colspan="3" class="unavailable">Not qualified for this fixture. <a href="{{ snapshot.path }}">Inspect the {{ row.failureStage }} diagnostic ↗</a></td>@endif</tr>
    @endforeach
    </tbody></table></div>
    @endforeach
  </section>
  @endforeach
  <div class="notice"><h3>{{ snapshot.label }}. One machine. A defined workload.</h3><p>Measured {{ snapshot.measuredDate }} on {{ snapshot.report.machine.cpu }}, {{ snapshot.label }} {{ snapshot.report.machine.arch }}, {{ snapshot.report.machine.cores }} CPU cores, {{ snapshot.memoryGiB }} GiB memory, {{ snapshot.report.runtime }}. This snapshot uses a hosted GitHub Actions runner. Virtualization and shared host activity can affect timings. Ranges and raw samples are visible.</p></div>
  <div class="benchmark-caveat">
    <p>{{ snapshot.label }} · {{ snapshot.workloadLabel }} · 100 modules.</p>
    @if(snapshot.fastestEmitter)<p>{{ snapshot.fastestEmitter }} has the lowest per-module emission median among qualified configurations.</p>@else<p>No per-module emitter qualified for this fixture.</p>@endif
    @if(snapshot.fastestBundler)<p>{{ snapshot.fastestBundler }} has the lowest standalone bundle median among qualified configurations.</p>@else<p>No standalone bundle configuration qualified for this fixture.</p>@endif
    <p>Close medians with overlapping ranges should be treated as similar performance. Compare within the selected platform, fixture and output group.</p>
  </div>
  </div>
  @endforeach
  <noscript><p class="notice">Download the raw results for every project size. Enable JavaScript to filter the tables.</p></noscript>
  <section id="engine" class="lab-group" aria-labelledby="engine-heading">
    <h2 id="engine-heading">Engine benchmarks.</h2>
    <p>The lab above times whole published workflows on hosted runners. These numbers come from dtsx's own suite: the emitter itself, file by file, against oxc and TypeScript 7. Measured {{ engineMeasured }} on {{ engineMachine.cpu }} (<code>{{ engineMachine.model }}</code>), {{ engineCores }}, {{ engineMachine.memoryGB }} GB memory, {{ engineMachine.os }}, Bun {{ engineMachine.bun }}. dtsx is version {{ engineMachine.versions.dtsx }}. Each tool's output is verified before timing, and dtsx runs in its value-inferring mode. Times are means; lower is faster.</p>
    @foreach(engineTables as table)
    <div class="table-scroll"><table class="results-table" id="{{ table.id }}"><caption>{{ table.title }}. {{ table.detail }}</caption><thead><tr><th scope="col">Tool</th>@foreach(table.columns as column)<th scope="col">{{ column }}</th>@endforeach</tr></thead><tbody>
    @foreach(table.rows as row)
    <tr class="{{ row.dtsx ? 'highlight-row' : '' }}"><th scope="row">{{ row.name }}</th>@foreach(row.cells as cell)<td class="number">@if(cell.best)<strong>{{ cell.text }}</strong>@else{{ cell.text }} <small>{{ cell.ratio }}</small>@endif</td>@endforeach</tr>
    @endforeach
    </tbody></table></div>
    @endforeach
    <h3 id="engine-sdk-heading">JavaScript SDK.</h3>
    <p>The @stacksjs/dtsx SDK, which powers the bundler and build-tool plugins, called in-process like the JavaScript SDKs it is compared with.</p>
    @foreach(sdkTables as table)
    <div class="table-scroll"><table class="results-table" id="{{ table.id }}"><caption>{{ table.title }}. {{ table.detail }}</caption><thead><tr><th scope="col">Tool</th>@foreach(table.columns as column)<th scope="col">{{ column }}</th>@endforeach</tr></thead><tbody>
    @foreach(table.rows as row)
    <tr class="{{ row.dtsx ? 'highlight-row' : '' }}"><th scope="row">{{ row.name }}</th>@foreach(row.cells as cell)<td class="number">@if(cell.best)<strong>{{ cell.text }}</strong>@else{{ cell.text }} <small>{{ cell.ratio }}</small>@endif</td>@endforeach</tr>
    @endforeach
    </tbody></table></div>
    @endforeach
    @if(engineBundled.length)
    <div class="table-scroll"><table class="results-table" id="engine-bundled"><caption>JS SDK, bundled declarations: fresh builds of the same project, checked by strict consumers outside timing.</caption><thead><tr><th scope="col">Source files</th><th scope="col">Tool</th><th scope="col">Average</th></tr></thead><tbody>
    @foreach(engineBundled as group)
    @foreach(group.rows as row)
    <tr class="{{ row.tool.startsWith('dtsx') ? 'highlight-row' : '' }}"><td>{{ group.files }}</td><th scope="row">{{ row.tool }}</th><td class="number">@if(row.best)<strong>{{ row.text }}</strong>@else{{ row.text }}@endif</td></tr>
    @endforeach
    @endforeach
    </tbody></table></div>
    @endif
    <div class="document-links"><a href="/benchmarks/engine.json" download>Download engine results ↓</a><a href="https://github.com/stacksjs/dtsx/tree/main/benchmark">Inspect and rerun the engine suite ↗</a></div>
  </section>
  <section id="workloads" class="notice"><h2>Two ways to write your API.</h2><p>The <strong>Explicit annotations</strong> fixture covers authored public types, generics, private fields, mapped types and enums. The <strong>Inferred APIs</strong> fixture omits type annotations and type assertions. It tests inferred defaults, returns, arrow functions, class members, objects, arrays and imported function results.</p><p>Every configuration receives the same source in the selected fixture. Emission failures and incorrect inferred types remain visible. Only fully qualified configurations receive medians. Raw results include the diagnostics.</p></section>
  <section id="methodology" class="methodology"><h2>What these results measure.</h2><div class="method-grid"><article><h3>Same source. Fresh process.</h3><p>Each tool receives the same source for the selected fixture. Every sample starts in a new process and a fresh output directory. Filesystem caches are warm. Incremental and result caches are not reused.</p></article><article><h3>Useful output comes first.</h3><p>Every sample must exit successfully, emit declarations, and pass a strict consumer covering every module. Exercised API positions must avoid <code>any</code>. Parameter types, arity and default optionality are checked. Inferred types must also preserve expected widening. Two negative assignments must produce exactly TS2322. Bundled declarations are tested in a standalone directory.</p></article><article><h3>The whole command counts.</h3><p>Wall time includes startup, package loading, source reads, emission, writes, and disposal. Cleanup and correctness checks happen outside timing. Two warmups precede nine samples, with tool order rotated each round.</p></article><article><h3>Different tools do different work.</h3><p>TypeScript compilers perform semantic checks. API Extractor and Rollup include prerequisite tsc emission. Vite runs its JavaScript pipeline. tsup and tsdown use declaration-only mode. The adapter source shows every setting.</p></article></div>
  <div class="notice"><h3>Separate platforms. The same workload.</h3><p>Every configuration is rerun on each platform. macOS and Linux timings stay separate, as do annotated and inferred APIs. A failed configuration is never ranked as a fast result. The fixtures exclude external dependencies, JSX, watch mode, declaration maps, and incremental rebuilds. The checks qualify this API; they do not prove correctness for arbitrary TypeScript.</p><p>The dtsx row uses the official <a href="{{ macReport.nativeZig.url }}">dtsx {{ macReport.nativeZig.version }} release</a>: its native engine library with the matching Bun binding. The dtsx JS SDK row uses the published npm package. Linux shared libraries target GNU libc 2.17. Inferred dtsx builds include project planning and dependency snapshots in the measured command; the native engine performs inference and emission. The setup verifies pinned SHA-256 checksums before measuring. The source commit and artifact checksums are included in each raw snapshot. <a href="https://github.com/stacksjs/dtsx/releases/download/v{{ macReport.nativeZig.version }}/checksums.txt">Inspect the release checksums ↗</a></p></div>
  <div class="document-links"><a href="https://github.com/stacksjs/dtsx.org/tree/main/benchmarks">Inspect and rerun the suite ↗</a><a href="/benchmarks/methodology.md" download>Download the methodology ↓</a><a href="https://github.com/stacksjs/dtsx.org/actions/workflows/benchmarks.yml">Run the macOS / Linux workflow ↗</a></div>
  </section>
</main>
@include('footer')
</body>
</html>
